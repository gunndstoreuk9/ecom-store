APP_ENV=production
API_BASE_URL=https://api.tawazonhealth.store
FRONTEND_URL=https://tawazonhealth.store
CORS_ORIGINS=https://tawazonhealth.store,https://www.tawazonhealth.store,http://localhost:3000

DATABASE_URL=postgres://tawazonhealth:tawazonhealth@tawazon_database:5432/tawazonhealth?sslmode=disable

SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyRXf5XXr4Xhk6uvgabm_K8dLo_hivxi7mkdNgGth_X1vjWDdhaxIRYckBX1CJwo0qPdQ/exec
ADMIN_API_KEY=change-this-secure-admin-key

# Digylog delivery API (optional). Set DIGYLOG_API_TOKEN to enable auto push on dispatch.
# Endpoint defaults to the v2 seller "Add orders" route; usually only the token + store are needed.
DIGYLOG_API_URL=https://api.digylog.com/api/v2/seller/orders
DIGYLOG_API_TOKEN=
DIGYLOG_STORE=
DIGYLOG_NETWORK=1
DIGYLOG_PORT=2
# 0 = add to Digylog "No sent" (review then send manually), 1 = add & send immediately
DIGYLOG_ADD_STATUS=0
# Optional shared secret to protect the inbound status webhook (recommended).
# Then register: https://api.tawazonhealth.store/v1/digylog/webhook?token=YOUR_SECRET
DIGYLOG_WEBHOOK_SECRET=
DIGYLOG_AUTH_HEADER=Authorization
DIGYLOG_AUTH_PREFIX=Bearer 
DIGYLOG_REFERER=https://apiseller.digylog.com

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_API_SECRET=
GA4_MEASUREMENT_ID=

LOG_LEVEL=INFO
