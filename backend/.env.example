APP_ENV=production
API_BASE_URL=https://api.tawazonhealth.store
FRONTEND_URL=https://tawazonhealth.store
CORS_ORIGINS=https://tawazonhealth.store,https://www.tawazonhealth.store,http://localhost:3000

DATABASE_URL=postgres://tawazonhealth:tawazonhealth@tawazon_database:5432/tawazonhealth?sslmode=disable

SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyRXf5XXr4Xhk6uvgabm_K8dLo_hivxi7mkdNgGth_X1vjWDdhaxIRYckBX1CJwo0qPdQ/exec
ADMIN_API_KEY=change-this-secure-admin-key

# Digylog delivery API (optional). Leave DIGYLOG_API_URL empty to use CSV export only.
# Base: https://api.digylog.com/api/v2/seller — set DIGYLOG_API_URL to the create-order endpoint.
DIGYLOG_API_URL=
DIGYLOG_API_TOKEN=
DIGYLOG_AUTH_HEADER=Authorization
DIGYLOG_AUTH_PREFIX=Bearer 
DIGYLOG_REFERER=https://apiseller.digylog.com

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_API_SECRET=
GA4_MEASUREMENT_ID=

LOG_LEVEL=INFO
